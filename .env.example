# 应用名称
APP_NAME=Campus RAG System
DEBUG=true

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=你的数据库用户名
DB_PASSWORD=你的数据库密码
DB_NAME=campus_rag_yanshisan

# 向量数据库配置
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=campus_knowledge

# JWT 配置
JWT_SECRET=填写一个随机安全密钥
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM 提供商 ollama | openai | deepseek
LLM_PROVIDER=deepseek

# ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# deepseek 配置
DEEPSEEK_API_KEY=填入你的 DeepSeek API Key
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_TYPE=deepseek-v4-flash

# openai 配置（可选）
# OPENAI_API_KEY=填入你的 OpenAI API Key
# OPENAIDEEPSEEK_API_BASE_URL=https://api.openai.cn/v1
# OPENAI_APIOPENAI_MODEL=gpt-3.5-turbo

# RAG 配置
CHUNK_SIZE=300
CHUNK_OVERLAP=20
RETRIEVER_TOP_K=3
SHOW_SOURCE=True